{
  "name": "@apparent/agent",
  "version": "0.1.0",
  "description": "Local .apparent bundle inspection CLI",
  "type": "module",
  "bin": { "apparent-agent": "./dist/cli.js" },
  "files": ["dist", "README.md"],
  "scripts": { "build": "tsc -p ../engine/sdk/tsconfig.json --typeRoots ./node_modules/@types && tsc -p tsconfig.json", "test": "npm run build && node --experimental-strip-types --test test/*.test.ts", "prepack": "npm run build" },
  "dependencies": { "@apparent/engine-sdk": "file:../engine/sdk" },
  "bundledDependencies": ["@apparent/engine-sdk"],
  "engines": { "node": ">=22.6" },
  "devDependencies": { "@types/node": "22.19.0", "typescript": "5.9.3" }
}
