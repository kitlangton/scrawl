{
  "name": "@apparent/agent",
  "version": "0.1.0",
  "description": "Local .apparent bundle inspection CLI",
  "type": "module",
  "bin": {
    "apparent-agent": "./dist/cli.js",
    "apparent-agent-install-local": "./dist/install-local.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p ../engine/sdk/tsconfig.json --typeRoots ./node_modules/@types && tsc -p tsconfig.json",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts",
    "prepack": "npm run build",
    "typecheck": "tsc -p ../engine/sdk/tsconfig.json --typeRoots ./node_modules/@types && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@apparent/engine-sdk": "file:../engine/sdk",
    "pngjs": "^7.0.0"
  },
  "bundledDependencies": [
    "@apparent/engine-sdk",
    "pngjs"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bundleDependencies": [
    "@apparent/engine-sdk",
    "pngjs"
  ]
}
