{
  "name": "@apparent/agent",
  "version": "0.1.0",
  "description": "Local .apparent bundle inspection CLI",
  "type": "module",
  "bin": {
    "apparent-agent": "./dist/cli.js",
    "apparent-agent-install-local": "./dist/install-local.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@apparent/engine-sdk": "file:vendor/apparent-engine-sdk-0.4.6.tgz",
    "@apparent/record": "file:vendor/apparent-record-0.1.0.tgz",
    "@types/node": "22.19.0",
    "pngjs": "^7.0.0",
    "@apparent/app-contracts": "file:vendor/apparent-app-contracts-0.1.0.tgz",
    "@apparent/native-host": "file:vendor/apparent-native-host-0.1.0.tgz"
  },
  "bundledDependencies": [
    "@apparent/engine-sdk",
    "@apparent/record",
    "@types/node",
    "pngjs",
    "@apparent/app-contracts",
    "@apparent/native-host"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bundleDependencies": [
    "@apparent/engine-sdk",
    "@apparent/record",
    "@types/node",
    "pngjs",
    "@apparent/app-contracts",
    "@apparent/native-host"
  ]
}
