{
  "name": "@apparent/onboarding",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md",
    "tsconfig.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && esbuild src/controller.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/controller.js && cp src/styles.css dist/styles.css && mkdir -p dist/assets dist/guides && cp src/assets/frog.png src/assets/apparent-app-icon.svg dist/assets/ && cp src/guides/*.css dist/guides/",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@apparent/app-contracts": "0.1.0",
    "@apparent/record": "0.1.0",
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@apparent/app-contracts": { "optional": true },
    "@apparent/record": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apparent/record": "file:vendor/record-0.1.0-afd73fb.tgz",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "^19.2.7",
    "esbuild": "0.25.12",
    "jsdom": "^26.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "@apparent/app-contracts": "file:vendor/apparent-app-contracts-0.1.0.tgz"
  }
}
