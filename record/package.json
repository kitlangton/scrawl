{
  "name": "@apparent/record",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "tsconfig.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    },
    "./fixtures": {
      "types": "./dist/capabilities/fixtures.d.ts",
      "import": "./dist/capabilities/fixtures.js"
    },
    "./host": {
      "types": "./dist/backend/host/index.d.ts",
      "import": "./dist/backend/host/index.js"
    },
    "./host/capture2": {
      "types": "./dist/backend/host/capture2.d.ts",
      "import": "./dist/backend/host/capture2.js"
    },
    "./host/capture2-runtime": {
      "types": "./dist/backend/host/capture2/runtime.d.ts",
      "import": "./dist/backend/host/capture2/runtime.js"
    },
    "./host/native": {
      "types": "./dist/backend/host/native/index.d.ts",
      "import": "./dist/backend/host/native/index.js"
    },
    "./host/materials": {
      "types": "./dist/backend/host/materials.d.ts",
      "import": "./dist/backend/host/materials.js"
    },
    "./processing": {
      "types": "./dist/backend/processing/index.d.ts",
      "import": "./dist/backend/processing/index.js"
    },
    "./processing/media-consumer": {
      "types": "./dist/backend/processing/media-consumer.d.ts",
      "import": "./dist/backend/processing/media-consumer.js"
    },
    "./publication": {
      "types": "./dist/backend/publication/index.d.ts",
      "import": "./dist/backend/publication/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/style.css": "./dist/ui/style.css",
    "./processing/bundle": {
      "types": "./dist/backend/processing/bundle/index.d.ts",
      "import": "./dist/backend/processing/bundle/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node --experimental-strip-types scripts/build-ui.ts && tailwindcss -i src/ui/style.css -o dist/ui/style.css && node --experimental-strip-types scripts/copy-ui-assets.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts test/*/*.test.ts",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test:package": "node --experimental-strip-types test/package-smoke.ts",
    "test:package:native:capture2": "APPARENT_CAPTURE2_QUALIFY=1 node --experimental-strip-types test/package-smoke.ts",
    "test:contracts": "tsc --noEmit --allowImportingTsExtensions --module NodeNext --target ES2022 --strict --types node test/native-host/adapter.types.ts"
  },
  "peerDependencies": {
    "@apparent/engine-sdk": "^0.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@apparent/engine-sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.2.0",
    "typescript": "5.9.3",
    "@apparent/ui": "file:../shared/ui",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.67.0",
    "tailwind-merge": "^3.3.1",
    "esbuild": "0.25.12",
    "@tailwindcss/cli": "4.1.17",
    "@apparent/engine-sdk": "file:vendor/engine-sdk-0.3.2.tgz",
    "@apparent/app-contracts": "file:vendor/app-contracts-0.1.0-a8194a4.tgz",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
