{
  "name": "@apparent/native-resources",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./installed": "./dist/installed.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test test/client.test.ts test/artifact.test.ts test/installed.test.ts",
    "test:native": "node --experimental-strip-types --test test/native.test.ts",
    "prepack": "npm run build",
    "pack": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
