{
  "name": "@apparent/connect-static-hosting",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "npm run prepare:service && tsc --noEmit",
    "build": "npm run prepare:service && npm --prefix ../../web run build && node scripts/package.ts && node scripts/bundle.ts",
    "test": "npm run build && tsc --noEmit && node --test test/*.test.ts && node scripts/test-runtime.ts && node scripts/validate-output.ts",
    "test:runtime": "node scripts/test-runtime.ts",
    "dev": "wrangler dev --config wrangler.template.jsonc --local --ip 127.0.0.1",
    "verify:artifact": "node scripts/verify.ts",
    "prepare:service": "npm --prefix ../../service ci --include=dev && npm --prefix ../../service run build:recipient"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "wrangler": "4.158.0"
  }
}
