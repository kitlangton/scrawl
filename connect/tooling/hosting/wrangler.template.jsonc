{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apparent-connect-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "assets": {
    "directory": ".output/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
