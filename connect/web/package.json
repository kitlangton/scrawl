{
  "name": "@apparent/connect-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test:routes": "node --test test/routes.test.mjs",
    "build": "python3 ../../shared/ui/scripts/check-theme.py --owner connect && tsc -b && node scripts/assets.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "test:artifact": "node --test test/artifact.test.mjs test/closure.test.mjs test/analytics-artifact.test.ts",
    "test:browser": "node test/browser.mjs",
    "test:analytics": "node scripts/test-analytics.ts",
    "test": "npm run build && npm run test:artifact && npm run test:routes && node scripts/test-browser.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
