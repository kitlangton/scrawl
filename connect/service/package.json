{
  "name": "apparent-hosted",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "python3 ../../shared/ui/scripts/check-theme.py && npm run build:recipient && npm run typecheck && esbuild src/worker.ts --bundle --format=esm --platform=browser --conditions=workerd --external:node:* --outfile=dist/worker.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*/*.test.mjs test/*/*.test.ts",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "build:recipient": "node scripts/build-recipient.mjs",
    "test:evidence-cli": "node --experimental-strip-types ../client/tests/evidence-service.ts",
    "test:recipient": "node test/sharing/recipient-browser.mjs"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.15",
    "better-auth": "1.7.15",
    "jose": "6.1.3",
    "@apparent/ui": "file:../../shared/ui",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3",
    "wrangler": "4.156.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17",
    "@tailwindcss/cli": "^4.1.17",
    "playwright-core": "1.63.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    }
  }
}
