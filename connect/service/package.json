{
  "name": "apparent-hosted",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && esbuild src/worker.ts --bundle --format=esm --platform=browser --conditions=workerd --external:node:* --outfile=dist/worker.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*/*.test.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.15",
    "better-auth": "1.7.15",
    "jose": "6.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    }
  }
}
