{
  "name": "@apparent/connect-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": "./dist/index.js",
    "./recipient-publication": "./dist/recipient/publication.js",
    "./recipient-command": "./dist/cli/recipient.js",
    "./credentials": "./dist/credentials/index.js",
    "./state": "./dist/state/namespace.js",
    "./queue": "./dist/queue/index.js",
    "./settings-controller": "./dist/settings-controller.cjs",
    "./settings-transport": "./dist/settings-transport.cjs",
    "./settings-presentation": "./dist/settings-presentation.js"
  },
  "scripts": {
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts test/recipient/*.test.ts test/cli/*.test.ts test/queue/*.test.ts test/credentials/*.test.ts test/state/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "pack": "npm pack --dry-run",
    "test:service": "node --experimental-strip-types --test test/integration/service.test.ts"
  },
  "dependencies": {
    "age-encryption": "0.3.1",
    "@noble/ed25519": "3.2.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
