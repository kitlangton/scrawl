{
  "name": "@apparent/connect-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": "./dist/index.js",
    "./recipient-publication": "./dist/recipient/publication.js",
    "./recipient-command/state": "./dist/cli/recipient-state.js",
    "./recipient-host": "./dist/cli/recipient-host.js",
    "./grant-revocation": "./dist/account/revoke.js",
    "./device-transport": "./dist/account/device.js",
    "./account-status": "./dist/account/status.js",
    "./share-management": "./dist/account/shares.js",
    "./local-status": "./dist/cli/status-state.js",
    "./sender-upload": "./dist/sender/transport.js",
    "./sender-upload/encrypted": "./dist/sender/encrypted-transport.js",
    "./sender-upload/authority": "./dist/sender/authority.js",
    "./sender-seal": "./dist/sender/seal.js",
    "./sender-spool": "./dist/sender/spool-reader.js",
    "./recipient-command/renewal": "./dist/state/renewal-owner.js",
    "./recipient-command": "./dist/cli/recipient.js",
    "./endpoint-identity": "./dist/credentials/recipient-identity.js",
    "./credentials": "./dist/credentials/index.js",
    "./state": "./dist/state/namespace.js",
    "./queue": "./dist/queue/index.js",
    "./settings-controller": "./dist/settings-controller.cjs",
    "./settings-transport": "./dist/settings-transport.cjs",
    "./settings-presentation": "./dist/settings-presentation.js"
  },
  "scripts": {
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts test/recipient/*.test.ts test/cli/*.test.ts test/queue/*.test.ts test/credentials/*.test.ts test/state/*.test.ts test/sender/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "pack": "npm pack --dry-run",
    "test:service": "node --experimental-strip-types --test test/integration/service.test.ts"
  },
  "dependencies": {
    "age-encryption": "0.3.1",
    "@noble/ed25519": "3.2.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
