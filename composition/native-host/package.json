{
  "name": "@apparent/native-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist", "README.md"],
  "exports": {
    ".": { "types": "./dist/client.d.ts", "import": "./dist/client.js" },
    "./pen": { "types": "./dist/pen.d.ts", "import": "./dist/pen.js" },
    "./clipboard": { "types": "./dist/clipboard.d.ts", "import": "./dist/clipboard.js" }
  },
  "scripts": {
    "build": "npm --prefix ../../shared/contracts run build && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "pretypecheck": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/client.test.ts",
    "test:packed": "node --experimental-strip-types test/packed-consumer.ts"
  },
  "peerDependencies": { "@apparent/app-contracts": "0.1.0" },
  "devDependencies": {
    "@apparent/app-contracts": "file:../../shared/contracts",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  },
  "engines": { "node": ">=22.18" }
}
