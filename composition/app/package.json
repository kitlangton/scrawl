{
  "name": "@apparent/app-shell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/assembly.test.ts tests/host.test.ts tests/onboarding-progress-bridge.test.ts",
    "check": "npm --prefix ../../shared/contracts run build && npm --prefix ../../shared/contracts run typecheck && npm --prefix ../../shared/contracts test && node scripts/check-installed.ts && npm run typecheck && npm test",
    "build:shell": "node scripts/build.ts shell",
    "assemble": "node scripts/assemble.ts dist/shell dist/app",
    "build": "node scripts/build.ts app && npm run assemble",
    "prepare:electron": "node node_modules/electron/install.js",
    "prestart": "npm run prepare:electron",
    "start": "electron dist/app",
    "package": "node scripts/package.ts dist/app dist/packages",
    "test:electron": "node --experimental-strip-types --test tests/electron.test.ts",
    "test:electron:onboarding": "node --experimental-strip-types --test tests/onboarding-bridge.electron.test.ts"
  },
  "dependencies": {
    "@apparent/app-contracts": "file:../../shared/contracts",
    "@apparent/ui": "file:../../shared/ui",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "electron": "45.2.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
