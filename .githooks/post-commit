#!/usr/bin/env python3
"""Report incoming main changes for integration assessment; never rebase."""
import os
from pathlib import Path
import signal
import subprocess
import sys


def git(*args):
    return subprocess.check_output(["git", *args], text=True, stderr=subprocess.DEVNULL).strip()


def notify(message):
    print(f"post-commit: {message}", file=sys.stderr)


def checkpoint():
    # Git paths are worktree-local, unlike a literal .git directory.
    for state in ("rebase-merge", "rebase-apply", "MERGE_HEAD", "CHERRY_PICK_HEAD",
                  "REVERT_HEAD", "sequencer", "BISECT_START"):
        if Path(git("rev-parse", "--git-path", state)).exists():
            return
    branch = git("symbolic-ref", "--quiet", "--short", "HEAD")
    if branch == "main":
        return

    # No credential prompts or unbounded network wait on the commit path.
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_ASKPASS="/bin/false",
               SSH_ASKPASS="/bin/false", GCM_INTERACTIVE="Never")
    fetch = subprocess.Popen(
        ["git", "-c", "credential.interactive=false", "fetch", "--quiet", "--no-tags",
         "--no-recurse-submodules", "origin", "refs/heads/main:refs/remotes/origin/main"],
        env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL, start_new_session=True)
    try:
        status = fetch.wait(timeout=5)
    except subprocess.TimeoutExpired:
        os.killpg(fetch.pid, signal.SIGKILL)
        fetch.wait()
        status = -1
    if status:
        notify("could not refresh origin/main; freshness is unknown. Fetch and check main before continuing.")
        return

    main = git("rev-parse", "--verify", "refs/remotes/origin/main^{commit}")
    head = git("rev-parse", "HEAD")
    contained = subprocess.run(["git", "merge-base", "--is-ancestor", main, head],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if contained.returncode == 0:
        return
    if contained.returncode != 1:
        raise RuntimeError("cannot compare main with HEAD")
    base = git("merge-base", main, head)
    # NUL delimiters preserve unusual filenames; repr keeps terminal output inert.
    incoming = git("diff", "--name-only", "-z", base, main).split("\0")
    incoming = sorted(path for path in incoming if path)
    local = set(git("diff", "--name-only", "-z", base, head).split("\0"))
    overlap = sorted(local.intersection(incoming))
    notify(f"INTEGRATION CHECKPOINT: fetched origin/main {main}; HEAD {head}.")
    notify(f"Incoming paths ({len(incoming)}): " + ", ".join(repr(p) for p in incoming))
    if overlap:
        notify("Changed on both branches (assess conflicts): " + ", ".join(repr(p) for p in overlap))
    owners = sorted({"/".join(p.split("/")[:2]) if p.startswith("capture/")
                     else p.split("/")[0] for p in incoming})
    notify("Incoming areas: " + ", ".join(repr(p) for p in owners))
    if any(p.startswith(("shared/", "enablement/", ".github/", ".githooks/", ".cargo/"))
           or "/" not in p for p in incoming):
        notify("Shared/build/verification contracts changed; assess consumers before continuing dependent work.")
    if git("status", "--porcelain", "--untracked-files=normal"):
        notify("Uncommitted work remains; preserve it explicitly before integrating. Do not auto-stash.")
    notify("Assess incoming contracts and dependencies; disjoint paths do not prove independence.")
    notify("Integrate now for conflicts or relevant changes; otherwise finish the bounded slice.")
    notify("Before merge, fetch current main, integrate and rerun affected checks with independent review.")
    notify("The commit succeeded; no rebase was run.")


if __name__ == "__main__":
    try:
        checkpoint()
    except subprocess.CalledProcessError:
        # Detached evidence checkouts have no owning branch to update.
        try:
            git("symbolic-ref", "--quiet", "HEAD")
        except subprocess.CalledProcessError:
            sys.exit(0)
        notify("checkpoint unavailable; fetch and check main before continuing. The commit is preserved.")
    except Exception:
        notify("checkpoint unavailable; fetch and check main before continuing. The commit is preserved.")
