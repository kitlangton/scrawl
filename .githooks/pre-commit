#!/bin/sh
# Enforce repository size limits against the index, never mutable file contents.
set -eu
repo_root=$(git rev-parse --show-toplevel)
if [ "${1:-}" != --within-budget ]; then
    exec python3 "$repo_root/enablement/verification.py" --hook-budget 60 sh "$0" --within-budget "$@"
fi
shift
python3 "$repo_root/enablement/directory-width/check.py"
exec node --experimental-strip-types "$repo_root/enablement/file-length/check.ts"
