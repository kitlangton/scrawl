#!/bin/sh
# Enforce width against the staged tree, never the mutable worktree.
set -eu
repo_root=$(git rev-parse --show-toplevel)
if [ "${1:-}" != --within-budget ]; then
    exec python3 "$repo_root/enablement/verification.py" --hook-budget 60 sh "$0" --within-budget "$@"
fi
shift
exec python3 "$repo_root/enablement/directory-width/check.py"
