#!/usr/bin/env python3
"""Reject unverified new local commits before refs move; leave old history alone."""
import subprocess
import sys


def git(*args):
    return subprocess.check_output(["git", *args], text=True).strip()


def check():
    if sys.argv[1:] != ["prepared"]:
        return
    tips = set()
    for line in sys.stdin:
        _old, new, ref = line.split()
        # Modern Git reports symbolic-ref changes as ref:<target>, not object
        # IDs. Commit-bearing branch updates in the same transaction are still
        # checked below; moving HEAD's pointer introduces no commit itself.
        if new.startswith("ref:"):
            continue
        if (ref == "HEAD" or ref.startswith("refs/heads/")) and new.strip("0"):
            tips.add(new)
    if not tips:
        return
    # Exclude commits already reachable locally, including fetched history. This
    # checks new commits in a batch without imposing policy on existing history,
    # branch switches, resets, remote-tracking updates, tags or ref deletions.
    commits = git("rev-list", *sorted(tips), "--not", "--all").splitlines()
    for commit in commits:
        result = subprocess.run(["git", "verify-commit", commit],
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        if result.returncode:
            print(f"commit signing: rejecting {commit}: a verifiable signature is required.\n"
                  "Enable commit.gpgsign and configure a signing key and verification trust "
                  "(gpg.ssh.allowedSignersFile for SSH). Author and committer identities "
                  "are unrestricted.", file=sys.stderr)
            print(result.stderr.strip(), file=sys.stderr)
            sys.exit(1)


if __name__ == "__main__":
    try:
        check()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"commit signing: cannot verify proposed ref update: {error}", file=sys.stderr)
        sys.exit(1)
