{
  "schema": 1,
  "id": "public",
  "kind": "directory",
  "package": "public/site",
  "packageManager": "bun",
  "inputs": [
    "public/",
    "shared/ui/",
    "shared/analytics/",
    "shared/assets/"
  ],
  "files": [
    "README.md",
    "capture/agent/skills/apparent/SKILL.md",
